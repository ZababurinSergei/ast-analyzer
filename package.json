{
  "name": "@newkind/ast-analyzer",
  "version": "5.1.1",
  "description": "🔍 AST Analyzer - AI Toolkit для анализа кода с GraphStore и CompactReportConfig",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ast-analyzer": "./dist/cli.js",
    "ast-cicd": "./dist/cli-cicd.js",
    "ast-semantic": "./dist/cli-semantic.js",
    "ast-refactor": "./dist/cli-refactor.js",
    "ast-ts-validator": "./dist/cli-ts-validator.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./formal": {
      "types": "./dist/formal/index.d.ts",
      "import": "./dist/formal/index.js"
    },
    "./refactor": {
      "types": "./dist/refactor/index.d.ts",
      "import": "./dist/refactor/index.js"
    },
    "./semantic": {
      "types": "./dist/semantic/index.d.ts",
      "import": "./dist/semantic/index.js"
    },
    "./reporters": {
      "types": "./dist/reporters/index.d.ts",
      "import": "./dist/reporters/index.js"
    },
    "./analyzers": {
      "types": "./dist/analyzers/index.d.ts",
      "import": "./dist/analyzers/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    }
  },
  "scripts": {
    "check": "npx tsc --noEmit --skipLibCheck --excludeDirectories ./src/process",
    "build:infoenergo": "tsx ./src/cli.ts compact-recursive ./infoenergo-ui/src/index.ts --preset full --depth 1000 -o ./infoenergo-ui/index.json",
    "build:graph": "tsx ./src/cli.ts compact-recursive ./src/index.ts --preset full --depth 1000 -o ./src/process/index.json",
    "build:decode:roundTrip": "tsx ./decode.ts",
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "dev": "tsx ./src/cli.ts",
    "cli": "tsx ./src/cli.ts",
    "cli:semantic": "tsx ./src/cli-semantic.ts",
    "cli:refactor": "tsx ./src/cli-refactor.ts",
    "cli:cicd": "tsx ./src/cli-cicd.ts",
    "cli:validator": "tsx ./src/cli-ts-validator.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "clean": "rm -rf dist coverage reports",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "graph:enrich": "tsx scripts/enrich-report-with-graph.ts",
    "graph:full": "npm run graph:enrich -- ./reports/project-compact-full.json ./src",
    "graph:validate": "tsx scripts/validate-graph.ts",
    "report:compact": "tsx ./src/cli.ts compact-recursive ./src/index.ts --preset standard --depth 100 -o ./reports/compact.json",
    "report:full": "tsx ./src/cli.ts compact-recursive ./src/index.ts --preset full --depth 1000 -o ./reports/full.json",
    "report:graphs": "tsx ./src/cli.ts compact-recursive ./src/index.ts --preset relationships --depth 1000 -o ./reports/graphs-only.json",
    "report:ultra": "tsx ./src/cli.ts compact-recursive ./src/index.ts --preset ultra --ultra --minify-keys -o ./reports/ultra.json",
    "report:custom": "tsx ./src/cli.ts compact-recursive ./src/index.ts --preset minimal --no-imports --no-exports --include-body -o ./reports/custom.json",
    "report:stats": "tsx ./src/cli.ts compact-recursive ./src/index.ts --no-relations --no-functions --no-constants --stats -o ./reports/stats-only.json",
    "report:vue": "tsx ./src/cli.ts compact-recursive ./src/index.ts --preset full --vue-templates --depth 1000 -o ./reports/vue-full.json",
    "report:all": "npm run report:compact && npm run report:full && npm run report:graphs && npm run report:ultra && npm run report:custom && npm run report:stats && npm run report:vue",
    "validate:graph": "tsx scripts/validate-graph.ts ./reports/full.json",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "===================== СИСТЕМНЫЕ ВЫЗОВЫ =====================": "",
    "start:win": "node ./dist/cli.js project ./src/cli.ts 15 -o ./reports/component-tree-deep",
    "start:win:abs": "node ./dist/cli.js project %CD%/src/cli.ts 15 -o ./reports/component-tree-deep",
    "start:ts": "NODE_OPTIONS=\"--trace-warnings --unhandled-rejections=strict\" tsx src/cli.ts project src/cli.ts 15 -o ./reports/component-tree-deep --entities 2>&1 | tee debug.log\n",
    "build:types": "tsc --emitDeclarationOnly --declaration --declarationMap --outDir dist",
    "build:bundle": "cross-env NODE_ENV=production  node esbuild.bundle.config.js",
    "build:cli": "cross-env NODE_ENV=production  node esbuild.cli.config.js",
    "build:prod": "cross-env NODE_ENV=production  npm run build",
    "start": "node dist/cli.js",
    "semantic": "node dist/cli-semantic.js",
    "semantic:analyze": "node dist/cli-semantic.js analyze",
    "semantic:callgraph": "node dist/cli-semantic.js callgraph",
    "semantic:cfg": "node dist/cli-semantic.js cfg",
    "semantic:types": "node dist/cli-semantic.js types",
    "semantic:dataflow": "node dist/cli-semantic.js dataflow",
    "semantic:verify": "node dist/cli-semantic.js verify",
    "semantic:dead": "node dist/cli-semantic.js dead",
    "semantic:help": "node dist/cli-semantic.js --help",
    "refactor": "node dist/cli-refactor.js",
    "refactor:dry": "node dist/cli-refactor.js refactor --dry-run",
    "refactor:analyze": "node dist/cli-refactor.js analyze",
    "refactor:validate": "node dist/cli-refactor.js validate",
    "cicd": "npm run semantic && npm run verify",
    "cicd:quick": "node dist/cli-cicd.js quick",
    "cicd:full": "node dist/cli-cicd.js full",
    "cicd:pipeline": "node dist/cli-cicd.js pipeline",
    "cicd:status": "node dist/cli-cicd.js status",
    "===================== UI TESTS =====================": "",
    "test:ui": "vitest --ui",
    "test:ui:src/__tests__": "vitest src/__tests__ --ui --no-open",
    "test:ui:src/__tests__/file": "vitest src/__tests__/minifier.test.ts --ui --no-open",
    "test:ui:src/__tests__/file:string": "vitest --ui --no-open  src/__tests__/minifier.test.ts -t \"должен обрабатывать ошибку statSync при сборе файлов\"",
    "test:ui:src/formal/__tests__": "vitest src/formal/__tests__ --ui --no-open",
    "test:ui:src/formal/__tests__/file": "vitest src/formal/__tests__/EquivalenceChecker.test.ts --ui --no-open",
    "test:ui:src/formal/__tests__/file:string": "vitest --ui --no-open  src/formal/__tests__/EquivalenceChecker.test.ts -t \"should use Z3 for formal verification\"",
    "semantic:ts": "tsx packages/ast-analyzer/src/cli-semantic.ts",
    "===================== проверка типов =====================": "",
    "type-check": "tsc --noEmit",
    "type-check:test": "tsc --noEmit -p tsconfig.test.json",
    "type-check:all": "npm run type-check && npm run type-check:test",
    "===================== тесты =====================": "",
    "test:watch": "vitest --watch",
    "test:coverage:html": "vitest run --coverage --coverage.reporter=html",
    "test:coverage:lcov": "vitest run --coverage --coverage.reporter=lcov",
    "===================== ФОРМАЛЬНАЯ ВЕРИФИКАЦИЯ (Z3) =====================": "",
    "test:formal": "vitest src/formal/__tests__/*.test.ts --run",
    "test:formal:watch": "vitest src/formal/__tests__/*.test.ts",
    "test:formal:coverage": "vitest src/formal/__tests__/*.test.ts --run --coverage",
    "test:z3": "vitest src/formal/__tests__/Z3Verifier.test.ts --run",
    "test:z3:watch": "vitest src/formal/__tests__/Z3Verifier.test.ts",
    "test:equivalence": "vitest src/formal/__tests__/EquivalenceChecker.test.ts --run",
    "test:equivalence:watch": "vitest src/formal/__tests__/EquivalenceChecker.test.ts",
    "test:refactoring-equivalence": "vitest src/formal/__tests__/RefactoringEquivalenceChecker.test.ts --run",
    "test:refactoring-equivalence:watch": "vitest src/formal/__tests__/RefactoringEquivalenceChecker.test.ts",
    "test:refactoring-equivalence:coverage": "vitest src/formal/__tests__/RefactoringEquivalenceChecker.test.ts --run --coverage",
    "test:formal:integration": "vitest src/formal/__tests__/formal-integration.test.ts --run",
    "===================== СЕМАНТИЧЕСКИЙ АНАЛИЗ =====================": "",
    "test:semantic": "vitest src/semantic/__tests__/*.test.ts --run",
    "test:semantic:watch": "vitest src/semantic/__tests__/*.test.ts",
    "test:semantic:coverage": "vitest src/semantic/__tests__/*.test.ts --run --coverage",
    "test:cfg": "vitest src/semantic/__tests__/CFGAnalyzer.test.ts --run",
    "test:callgraph": "vitest src/semantic/__tests__/CallGraphAnalyzer.test.ts --run",
    "test:dataflow": "vitest src/semantic/__tests__/DataFlowAnalyzer.test.ts --run",
    "test:type-analyzer": "vitest src/semantic/__tests__/TypeAnalyzer.test.ts --run",
    "test:jsx": "vitest src/refactor/__tests__/jsx-vue-analyzers.test.ts --run",
    "===================== РЕФАКТОРИНГ =====================": "",
    "test:refactor": "vitest src/refactor/__tests__/refactor.test.ts --run",
    "test:refactor:watch": "vitest src/refactor/__tests__/refactor.test.ts",
    "test:refactor:coverage": "vitest src/refactor/__tests__/refactor.test.ts --run --coverage",
    "test:semantic-refactor": "vitest src/refactor/__tests__/semantic-refactor.test.ts --run",
    "test:semantic-refactor:watch": "vitest src/refactor/__tests__/semantic-refactor.test.ts",
    "test:semantic-refactor-high": "vitest src/refactor/__tests__/semantic-refactor-high-priority.test.ts --run",
    "test:semantic-refactor-medium": "vitest src/refactor/__tests__/semantic-refactor-medium-priority.test.ts --run",
    "test:semantic-refactor-low": "vitest src/refactor/__tests__/semantic-refactor-low-priority.test.ts --run",
    "test:semantic-refactor:all": "npm run test:semantic-refactor-high && npm run test:semantic-refactor-medium && npm run test:semantic-refactor-low",
    "test:incremental": "vitest src/refactor/__tests__/incremental.test.ts --run",
    "test:validator": "vitest src/refactor/__tests__/validator.test.ts --run",
    "===================== ИМПОРТЫ И ИХ ИСПРАВЛЕНИЯ =====================": "",
    "test:imports": "vitest src/refactor/__tests__/import-fixes.test.ts --run",
    "test:imports:watch": "vitest src/refactor/__tests__/import-fixes.test.ts",
    "test:imports:extra": "vitest src/refactor/__tests__/import-fixes-extra.test.ts --run",
    "test:imports:edge": "vitest src/refactor/__tests__/import-fixes-edge.test.ts --run",
    "test:imports:all": "vitest src/refactor/__tests__/import-fixes*.test.ts --run",
    "test:imports:coverage": "vitest src/refactor/__tests__/import-fixes*.test.ts --run --coverage",
    "===================== АНАЛИЗАТОРЫ (ESLint, TS, Code Validation) =====================": "",
    "test:analyzers": "vitest src/refactor/__tests__/analyzers-comprehensive.test.ts --run",
    "test:analyzers:watch": "vitest src/refactor/__tests__/analyzers-comprehensive.test.ts",
    "test:analyzers:edge": "vitest src/refactor/__tests__/analyzers-edge-cases.test.ts --run",
    "test:analyzers:edge:watch": "vitest src/refactor/__tests__/analyzers-edge-cases.test.ts",
    "test:analyzers:all": "vitest src/refactor/__tests__/analyzers-*.test.ts --run",
    "test:analyzers:coverage": "vitest src/refactor/__tests__/analyzers-*.test.ts --run --coverage",
    "===================== JSX/TSX И VUE ТЕСТЫ =====================": "",
    "test:jsx:watch": "vitest src/refactor/__tests__/jsx-vue-analyzers.test.ts",
    "test:jsx:coverage": "vitest src/refactor/__tests__/jsx-vue-analyzers.test.ts --run --coverage",
    "test:jsx-edge": "vitest src/refactor/__tests__/jsx-vue-advanced-edge.test.ts --run",
    "test:jsx-edge:watch": "vitest src/refactor/__tests__/jsx-vue-advanced-edge.test.ts",
    "test:jsx-edge:coverage": "vitest src/refactor/__tests__/jsx-vue-advanced-edge.test.ts --run --coverage",
    "test:jsx:all": "vitest src/refactor/__tests__/jsx-vue-analyzers.test.ts src/refactor/__tests__/jsx-vue-advanced-edge.test.ts --run",
    "test:jsx:all:watch": "vitest src/refactor/__tests__/jsx-vue-analyzers.test.ts src/refactor/__tests__/jsx-vue-advanced-edge.test.ts",
    "test:jsx:all:coverage": "vitest src/refactor/__tests__/jsx-vue-analyzers.test.ts src/refactor/__tests__/jsx-vue-advanced-edge.test.ts --run --coverage",
    "test:jsx:quick": "vitest src/refactor/__tests__/jsx-vue-analyzers.test.ts --run --testTimeout=5000",
    "test:jsx-edge:quick": "vitest src/refactor/__tests__/jsx-vue-advanced-edge.test.ts --run --testTimeout=5000",
    "test:jsx:all:quick": "vitest src/refactor/__tests__/jsx-vue-analyzers.test.ts src/refactor/__tests__/jsx-vue-advanced-edge.test.ts --run --testTimeout=5000",
    "test:jsx:debug": "vitest src/refactor/__tests__/jsx-vue-analyzers.test.ts --inspect-brk --no-file-parallelism",
    "test:jsx-edge:debug": "vitest src/refactor/__tests__/jsx-vue-advanced-edge.test.ts --inspect-brk --no-file-parallelism",
    "===================== CI/CD =====================": "",
    "test:cicd": "vitest src/ci-cd/__tests__/*.test.ts --run",
    "test:cicd:watch": "vitest src/ci-cd/__tests__/*.test.ts",
    "test:eslint-pipeline": "vitest src/ci-cd/__tests__/ESLintPipeline.test.ts --run",
    "test:semantic-pipeline": "vitest src/ci-cd/__tests__/SemanticPipeline.test.ts --run",
    "===================== CLI =====================": "",
    "test:cli": "vitest src/__tests__/cli-*.test.ts --run",
    "test:cli:watch": "vitest src/__tests__/cli-*.test.ts",
    "test:cli-semantic": "vitest src/__tests__/cli-semantic.test.ts --run",
    "test:cli-semantic:edge": "vitest src/__tests__/cli-semantic.edge.test.ts --run",
    "test:cli-refactor": "vitest src/__tests__/cli-refactor.test.ts --run",
    "test:cli-cicd": "vitest src/__tests__/cli-cicd.test.ts --run",
    "test:cli-ts-validator": "vitest src/__tests__/cli-ts-validator.test.ts --run",
    "===================== CORE =====================": "",
    "test:core": "vitest src/__tests__/ast-parser.test.ts src/__tests__/graph-utils.test.ts src/__tests__/file-graph.test.ts src/__tests__/minifier.test.ts src/__tests__/utils.test.ts --run",
    "test:core:watch": "vitest src/__tests__/ast-parser.test.ts src/__tests__/graph-utils.test.ts src/__tests__/file-graph.test.ts src/__tests__/minifier.test.ts src/__tests__/utils.test.ts",
    "test:ast-parser": "vitest src/__tests__/ast-parser.test.ts --run",
    "test:graph-utils": "vitest src/__tests__/graph-utils.test.ts --run",
    "test:file-graph": "vitest src/__tests__/file-graph.test.ts --run",
    "test:minifier": "vitest src/__tests__/minifier.test.ts --run",
    "test:utils": "vitest src/__tests__/utils.test.ts --run",
    "===================== VUE =====================": "",
    "test:vue": "vitest src/__tests__/vue-analyzer.test.ts --run || echo 'Vue tests skipped'",
    "test:vue:watch": "vitest src/__tests__/vue-analyzer.test.ts",
    "===================== ФИКСТУРЫ И ИНТЕГРАЦИЯ =====================": "",
    "test:fixtures": "vitest src/formal/__tests__/fixtures/**/*.test.ts --run",
    "test:integration": "vitest src/**/__tests__/*.integration.test.ts --run",
    "test:integration:watch": "vitest src/**/__tests__/*.integration.test.ts",
    "===================== ПРОИЗВОДИТЕЛЬНОСТЬ =====================": "",
    "test:performance": "vitest src/**/__tests__/*.performance.test.ts --run",
    "test:performance:watch": "vitest src/**/__tests__/*.performance.test.ts",
    "===================== ГРУППОВЫЕ ЗАПУСКИ =====================": "",
    "test:all:formal": "npm run test:z3 && npm run test:equivalence && npm run test:refactoring-equivalence && npm run test:formal:integration",
    "test:all:semantic": "npm run test:cfg && npm run test:callgraph && npm run test:dataflow && npm run test:type-analyzer && npm run test:jsx",
    "test:all:refactor": "npm run test:refactor && npm run test:semantic-refactor && npm run test:semantic-refactor:all && npm run test:incremental",
    "test:all:imports": "npm run test:imports && npm run test:imports:extra && npm run test:imports:edge",
    "test:all:analyzers": "npm run test:analyzers && npm run test:analyzers:edge",
    "test:all:cli": "npm run test:cli-semantic && npm run test:cli-semantic:edge && npm run test:cli-refactor && npm run test:cli-cicd && npm run test:cli-ts-validator",
    "test:all:core": "npm run test:ast-parser && npm run test:graph-utils && npm run test:file-graph && npm run test:minifier && npm run test:utils",
    "test:all:cicd": "npm run test:eslint-pipeline && npm run test:semantic-pipeline",
    "test:all:jsx": "npm run test:jsx:all",
    "test:all": "npm run test:all:formal && npm run test:all:semantic && npm run test:all:refactor && npm run test:all:imports && npm run test:all:analyzers && npm run test:all:cli && npm run test:all:core && npm run test:all:cicd && npm run test:all:jsx",
    "===================== БЫСТРЫЕ ЗАПУСКИ =====================": "",
    "test:quick": "vitest --run --testTimeout=5000",
    "test:quick:formal": "vitest src/formal/__tests__/*.test.ts --run --testTimeout=5000",
    "test:quick:refactor": "vitest src/refactor/__tests__/*.test.ts --run --testTimeout=5000",
    "test:quick:imports": "vitest src/refactor/__tests__/import-fixes*.test.ts --run --testTimeout=5000",
    "test:quick:analyzers": "vitest src/refactor/__tests__/analyzers-*.test.ts --run --testTimeout=5000",
    "test:quick:jsx": "npm run test:jsx:all:quick",
    "===================== CI/CD ЗАПУСКИ =====================": "",
    "test:ci": "vitest run --exclude src/__tests__/vue-analyzer.test.ts --coverage",
    "test:ci:formal": "vitest src/formal/__tests__/*.test.ts --run --coverage --coverage.reporter=lcov",
    "test:ci:imports": "vitest src/refactor/__tests__/import-fixes*.test.ts --run --coverage --coverage.reporter=lcov",
    "test:ci:analyzers": "vitest src/refactor/__tests__/analyzers-*.test.ts --run --coverage --coverage.reporter=lcov",
    "test:ci:jsx": "vitest src/refactor/__tests__/jsx-vue-analyzers.test.ts src/refactor/__tests__/jsx-vue-advanced-edge.test.ts --run --coverage --coverage.reporter=lcov",
    "test:ci:all": "npm run test:all:formal && npm run test:all:semantic && npm run test:all:refactor && npm run test:all:imports && npm run test:all:analyzers && npm run test:all:cli && npm run test:all:core && npm run test:all:cicd && npm run test:ci:jsx",
    "test:ci:with-jsx": "npm run test:ci && npm run test:ci:jsx",
    "test:all:with-jsx": "npm run test:all && npm run test:jsx:all",
    "===================== DEBUG =====================": "",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:debug:formal": "vitest src/formal/__tests__/RefactoringEquivalenceChecker.test.ts --inspect-brk --no-file-parallelism",
    "test:debug:refactor": "vitest src/refactor/__tests__/semantic-refactor.test.ts --inspect-brk --no-file-parallelism",
    "test:debug:imports": "vitest src/refactor/__tests__/import-fixes.test.ts --inspect-brk --no-file-parallelism",
    "test:debug:analyzers": "vitest src/refactor/__tests__/analyzers-comprehensive.test.ts --inspect-brk --no-file-parallelism",
    "test:debug:jsx": "vitest src/refactor/__tests__/jsx-vue-analyzers.test.ts --inspect-brk --no-file-parallelism",
    "test:debug:jsx-edge": "vitest src/refactor/__tests__/jsx-vue-advanced-edge.test.ts --inspect-brk --no-file-parallelism"
  },
  "keywords": [
    "ast",
    "parser",
    "analyzer",
    "typescript",
    "javascript",
    "vue",
    "jsx",
    "tsx",
    "call-graph",
    "data-flow",
    "control-flow",
    "type-analyzer",
    "semantic-analysis",
    "refactoring",
    "code-analysis",
    "ai-toolkit",
    "graph-store",
    "compact-report"
  ],
  "author": "Newkind",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/newkind/ast-analyzer"
  },
  "bugs": {
    "url": "https://github.com/newkind/ast-analyzer/issues"
  },
  "homepage": "https://github.com/newkind/ast-analyzer#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@codeflow-map/core": "latest",
    "@hpcc-js/dataflow": "latest",
    "@hpcc-js/wasm-graphviz": "latest",
    "@jitl/ts-simple-type": "latest",
    "@typescript-eslint/parser": "latest",
    "@vue/compiler-sfc": "latest",
    "commander": "latest",
    "eslint": "latest",
    "estree-walker": "latest",
    "execa": "latest",
    "glob": "latest",
    "ts-morph": "latest",
    "z3-solver": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@typescript-eslint/eslint-plugin": "latest",
    "@vitest/coverage-v8": "latest",
    "eslint-config-prettier": "latest",
    "eslint-plugin-import": "latest",
    "prettier": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "ts-prune": "latest",
    "knip": "latest"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ]
}
